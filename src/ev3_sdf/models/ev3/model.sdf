<?xml version="1.0" ?>
<sdf version="1.11">
  <model name="ev3">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>

    <!-- Chassis / EV3-Brick, Ursprung auf Achshöhe -->
    <link name="base_link">
      <pose>0 0 0.028 0 0 0</pose>
      <inertial>
        <mass>0.70</mass>
        <inertia>
          <ixx>0.00121</ixx>
          <iyy>0.00226</iyy>
          <izz>0.00273</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.08</size>
          </box>
        </geometry>
      </collision>
      <!-- Unterer Rahmen -->
      <visual name="chassis">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- EV3-Brick -->
      <visual name="brick">
        <pose>0.01 0 0.055 0 0 0</pose>
        <geometry>
          <box>
            <size>0.13 0.09 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.22 0.22 0.25 1</diffuse>
        </material>
      </visual>
      <!-- Display -->
      <visual name="screen">
        <pose>0.02 0 0.079 0 0 0</pose>
        <geometry>
          <box>
            <size>0.07 0.05 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.62 0.55 1</ambient>
          <diffuse>0.7 0.8 0.7 1</diffuse>
        </material>
      </visual>
      <!-- Roter Mittelknopf -->
      <visual name="button">
        <pose>0.02 0 0.081 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.08 0.08 1</ambient>
          <diffuse>0.9 0.12 0.12 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.075 0.028 1.570796 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000012</ixx>
          <iyy>0.000018</iyy>
          <izz>0.000012</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.075 0.028 1.570796 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000012</ixx>
          <iyy>0.000018</iyy>
          <izz>0.000012</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Stützrolle vorne -->
    <link name="caster">
      <pose>0.07 0 0.014 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <iyy>0.000002</iyy>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.014</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.42 1</ambient>
          <diffuse>0.55 0.55 0.58 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.15</wheel_separation>
      <wheel_radius>0.028</wheel_radius>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
