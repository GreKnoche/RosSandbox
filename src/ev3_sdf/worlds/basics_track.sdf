<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="basics_track">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.48 0.24 1</ambient>
            <diffuse>0.38 0.52 0.28 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Straße in der L-Strecke + Kreisbahn um die Mauern (10x10 m, 1:1 zur PNG) -->
    <model name="track_surface">
      <static>true</static>
      <pose>0.875 0.975 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://track_ground/materials/textures/track.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start (grün), Roboter spawnt hier Richtung +x -->
    <model name="start_pad">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.55 0.18 1</ambient>
            <diffuse>0.20 0.80 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ziel (rot) nach 90°-Kurve -->
    <model name="finish_pad">
      <static>true</static>
      <pose>1.70 1.55 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.10 0.10 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hinterwand am Start -->
    <model name="wall_back">
      <static>true</static>
      <pose>-0.5 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.75 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.75 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rechte Wand der Geraden (y negativ), bis zur Hinterwand bei x=-0.5 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0.75 -0.35 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.50 0.05 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.50 0.05 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Linke Wand der Geraden bis zur Kurve, bis zur Hinterwand bei x=-0.5 -->
    <model name="wall_north_approach">
      <static>true</static>
      <pose>0.45 0.35 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.90 0.05 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.90 0.05 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Äußere Wand nach der 90°-Kurve (x positiv) -->
    <model name="wall_east">
      <static>true</static>
      <pose>2.00 0.75 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 2.20 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 2.20 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Innere Wand nach der Kurve -->
    <model name="wall_west_exit">
      <static>true</static>
      <pose>1.40 1.125 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 1.55 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 1.55 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Abschlusswand hinter dem Ziel -->
    <model name="wall_end">
      <static>true</static>
      <pose>1.70 2.3 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.65 0.05 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.65 0.05 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Außenrahmen Süden -->
    <model name="frame_south">
      <static>true</static>
      <pose>0.875 -4.025 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.05 0.05 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.05 0.05 0.20</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Außenrahmen Norden -->
    <model name="frame_north">
      <static>true</static>
      <pose>0.875 6.0 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.05 0.05 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.05 0.05 0.20</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Außenrahmen Ost -->
    <model name="frame_east">
      <static>true</static>
      <pose>5.875 0.975 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 10.05 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 10.05 0.20</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Außenrahmen Westen -->
    <model name="frame_west">
      <static>true</static>
      <pose>-4.125 0.975 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 10.05 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 10.05 0.20</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.48 0.50 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Tor 1: Geradeausfahrt -->
    <model name="gate1_left">
      <static>true</static>
      <pose>0.60 0.22 0.12 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.55 0.05 1</ambient>
            <diffuse>0.95 0.70 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="gate1_right">
      <static>true</static>
      <pose>0.60 -0.22 0.12 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.55 0.05 1</ambient>
            <diffuse>0.95 0.70 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tor 2: Geradeausfahrt vor der Kurve -->
    <model name="gate2_left">
      <static>true</static>
      <pose>1.20 0.22 0.12 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.55 0.05 1</ambient>
            <diffuse>0.95 0.70 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="gate2_right">
      <static>true</static>
      <pose>1.20 -0.22 0.12 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.55 0.05 1</ambient>
            <diffuse>0.95 0.70 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
