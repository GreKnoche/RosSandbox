# Same-machine Gazebo transport + FastDDS. Source on the host before
# `gz topic` / ROS teleop:
#   set -a && source localhost.env && set +a && ros2 daemon stop
#
# GZ_IP: campus Wi-Fi has no IPv6 default route, so gz-transport multicast
# fails with "Network is unreachable".
# UDPv4: skip FastDDS shared memory (root vs desktop user cannot share it).
GZ_IP=127.0.0.1
GZ_PARTITION=ev3
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
