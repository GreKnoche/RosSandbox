<?xml version="1.0"?>
<!-- Frames and sizes match gazebo/src/ev3_gz_description/models/ev3/model.sdf -->
<robot name="ev3_educator">
  <material name="brick_white">
    <color rgba="0.93 0.93 0.91 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.28 0.29 0.30 1"/>
  </material>
  <material name="motor_grey">
    <color rgba="0.62 0.63 0.64 1"/>
  </material>
  <material name="lego_red">
    <color rgba="0.79 0.10 0.09 1"/>
  </material>
  <material name="black">
    <color rgba="0.08 0.08 0.08 1"/>
  </material>
  <material name="rim">
    <color rgba="0.70 0.71 0.72 1"/>
  </material>
  <material name="beam_white">
    <color rgba="0.96 0.96 0.94 1"/>
  </material>
  <material name="screen">
    <color rgba="0.10 0.13 0.11 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="-0.015 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.128 0.084 0.034"/>
      </geometry>
      <material name="brick_white"/>
    </visual>
    <visual>
      <origin xyz="0.006 0 0.063" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.070 0.003"/>
      </geometry>
      <material name="screen"/>
    </visual>
    <visual>
      <origin xyz="-0.038 0 0.063" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.042 0.004"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.014 0.021 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.108 0.040 0.040"/>
      </geometry>
      <material name="motor_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.014 -0.021 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.108 0.040 0.040"/>
      </geometry>
      <material name="motor_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0.043 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="lego_red"/>
    </visual>
    <visual>
      <origin xyz="0 -0.043 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="lego_red"/>
    </visual>
    <visual>
      <origin xyz="-0.010 0.046 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.064 0.008 0.048"/>
      </geometry>
      <material name="beam_white"/>
    </visual>
    <visual>
      <origin xyz="-0.010 -0.046 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.064 0.008 0.048"/>
      </geometry>
      <material name="beam_white"/>
    </visual>
    <collision>
      <origin xyz="-0.015 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.128 0.084 0.034"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.015 0 0.026" rpy="0 0 0"/>
      <mass value="0.475"/>
      <inertia ixx="0.00053" ixy="0" ixz="0" iyy="0.00081" iyz="0" izz="0.00082"/>
    </inertial>
  </link>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.028"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.022"/>
      <inertia ixx="0.00000575" ixy="0" ixz="0" iyy="0.00000862" iyz="0" izz="0.00000575"/>
    </inertial>
  </link>
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.028"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.022"/>
      <inertia ixx="0.00000575" ixy="0" ixz="0" iyy="0.00000862" iyz="0" izz="0.00000575"/>
    </inertial>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.059 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.059 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.012"/>
      <inertia ixx="0.00000031" ixy="0" ixz="0" iyy="0.00000031" iyz="0" izz="0.00000031"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.070 0 -0.020" rpy="0 0 0"/>
  </joint>

  <link name="gyro_link">
    <visual>
      <geometry>
        <box size="0.030 0.030 0.020"/>
      </geometry>
      <material name="brick_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.030 0.030 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.018"/>
      <inertia ixx="0.0000018" ixy="0" ixz="0" iyy="0.0000018" iyz="0" izz="0.0000018"/>
    </inertial>
  </link>
  <joint name="gyro_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gyro_link"/>
    <origin xyz="-0.088 0 0.052" rpy="0 0 0"/>
  </joint>

  <link name="ultrasonic_link">
    <visual>
      <origin xyz="-0.008 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.048 0.030"/>
      </geometry>
      <material name="brick_white"/>
    </visual>
    <visual>
      <origin xyz="0.008 0.012 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.008 -0.012 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.008 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.050 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.025"/>
      <inertia ixx="0.0000047" ixy="0" ixz="0" iyy="0.0000047" iyz="0" izz="0.0000047"/>
    </inertial>
  </link>
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.078 0 -0.004" rpy="0 0 0"/>
  </joint>
</robot>
